# JIGYASA LAB — Environment variables (.env.example)
# Copy this file to .env and fill in your own values locally.
# Never commit the real .env file. Add real credentials to GitHub repository secrets.

# Gemini API (Google AI Studio) — free tier model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Meta Graph API
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v27.0

# Publishing safety switch — must be "true" to actually publish to Facebook
PUBLISH_ENABLED=false

# Brand
BRAND_NAME=JIGYASA LAB
